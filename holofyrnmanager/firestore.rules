rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInMember() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function managerProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isMember() {
      return signedInMember()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && managerProfile().get('approved', true) == true;
    }

    function isAdmin() {
      return isMember()
        && managerProfile().role in ['Admin', 'admin'];
    }

    function isPublisher() {
      return isMember() && (managerProfile().role in ['Admin', 'admin', 'Coach', 'coach', 'Manager', 'manager', 'Captain', 'captain', 'Socials', 'socials']
        || managerProfile().get('canEdit', false) == true
        || managerProfile().get('coachAccess', false) == true
        || managerProfile().get('managerAccess', false) == true);
    }

    function canManageGoals() {
      return isMember()
        && managerProfile().role in ['Admin', 'admin', 'Coach', 'coach', 'Manager', 'manager'];
    }

    function canManageNews() {
      return isMember() && managerProfile().role in ['Admin', 'admin', 'Socials', 'socials'];
    }

    function isAssignedTo(teamId) {
      return isMember() && (managerProfile().get('teamId', '') == teamId
        || teamId in managerProfile().get('teamIds', []));
    }

    function isTeamCoach(teamId) {
      return isAssignedTo(teamId) && managerProfile().role in ['Coach', 'coach'];
    }

    function isAssignedPlayer(teamId) {
      return isAssignedTo(teamId)
        && (managerProfile().get('playerId', '') != ''
          || managerProfile().get('linkedPlayerId', '') != '');
    }

    function isOwnPlayer(playerId) {
      return managerProfile().get('playerId', '') == playerId
        || (managerProfile().get('playerId', '') == ''
          && managerProfile().get('linkedPlayerId', '') == playerId);
    }

    function validCoachingNote() {
      return request.resource.data.keys().hasOnly(['authorId', 'text', 'createdAt'])
        && request.resource.data.keys().hasAll(['authorId', 'text', 'createdAt'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000
        && request.resource.data.createdAt == request.time;
    }

    match /noctiqManager/main {
      allow read: if isMember();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isMember()
        && request.resource.data.get('players', []) == resource.data.get('players', [])
        && (canManageGoals()
          || request.resource.data.get('managerV8', {}).get('goals', [])
            == resource.data.get('managerV8', {}).get('goals', [])))
        || (canManageNews()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['managerV8', 'updatedAt'])
          && request.resource.data.get('managerV8', {}).diff(resource.data.get('managerV8', {})).affectedKeys().hasOnly(['news', 'newsInitialized']));
    }

    match /coachingTeams/{teamId}/notes/{noteId} {
      allow read: if isAdmin() || isTeamCoach(teamId) || isAssignedPlayer(teamId);
      allow create: if (isAdmin() || isTeamCoach(teamId)) && validCoachingNote();
      allow update: if false;
      allow delete: if isMember() && resource.data.authorId == request.auth.uid;
    }

    match /coachingPlayers/{teamId}/players/{playerId}/notes/{noteId} {
      allow read: if isAdmin() || isTeamCoach(teamId)
        || (isAssignedPlayer(teamId) && isOwnPlayer(playerId));
      allow create: if (isAdmin() || isTeamCoach(teamId)) && validCoachingNote();
      allow update: if false;
      allow delete: if isMember() && resource.data.authorId == request.auth.uid;
    }

    match /holofyrnPublic/main {
      allow read: if request.auth != null;
      allow create, update: if isPublisher()
        && request.resource.data.keys().hasOnly(['players', 'results', 'upcomingMatches', 'news', 'competitions', 'staff', 'publishedAt'])
        && request.resource.data.players is list
        && request.resource.data.results is list
        && request.resource.data.upcomingMatches is list
        && request.resource.data.get('news', []) is list
        && request.resource.data.get('competitions', []) is list
        && request.resource.data.get('staff', []) is list;
      allow delete: if false;
    }

    match /playerPortraits/{playerId} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['dataUrl', 'contentType', 'updatedBy', 'updatedAt'])
        && request.resource.data.keys().hasAll(['dataUrl', 'contentType', 'updatedBy', 'updatedAt'])
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() <= 500000
        && request.resource.data.dataUrl.matches('data:image/webp;base64,[A-Za-z0-9+/=]+')
        && request.resource.data.contentType == 'image/webp'
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /teamArt/{teamId} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin()
        && teamId.matches('[a-z0-9]+(-[a-z0-9]+)*')
        && request.resource.data.keys().hasOnly(['logoDataUrl', 'backgroundDataUrl', 'updatedBy', 'updatedAt'])
        && request.resource.data.keys().hasAny(['logoDataUrl', 'backgroundDataUrl'])
        && request.resource.data.get('logoDataUrl', '') is string
        && request.resource.data.get('logoDataUrl', '').size() <= 450000
        && request.resource.data.get('logoDataUrl', '').matches('(^$|data:image/webp;base64,[A-Za-z0-9+/=]+)')
        && request.resource.data.get('backgroundDataUrl', '') is string
        && request.resource.data.get('backgroundDataUrl', '').size() <= 450000
        && request.resource.data.get('backgroundDataUrl', '').matches('(^$|data:image/webp;base64,[A-Za-z0-9+/=]+)')
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isMember();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isMember() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'displayName', 'initials', 'discord', 'discordUrl',
          'instagramUrl', 'xUrl', 'tiktokUrl', 'bio', 'avatarData',
          'avatarScale', 'avatarX', 'avatarY'
        ]));
      allow delete: if false;
    }

    match /accountDeletionRequests/{userId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && userId != request.auth.uid
        && exists(/databases/$(database)/documents/users/$(userId))
        && request.resource.data.keys().hasOnly(['userId', 'requestedBy', 'status', 'requestedAt'])
        && request.resource.data.userId == userId
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(userId)).data.approved == false
        && getAfter(/databases/$(database)/documents/users/$(userId)).data.deletionPending == true;
      allow delete: if false;
    }
  }
}
