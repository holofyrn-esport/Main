[debug] [2026-10-16T00:01:48.362Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/noctiq-d1020/rulesets {"name":"projects/noctiq-d1020/rulesets/b3e4a173-0591-4038-a407-eea6995a8a1c","source":{"files":[{"content":"rules_version = '2';\r\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedInMember() {\n      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';\n    }\n\n    function managerProfile() {\n      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;\n    }\n\n    function isMember() {\n      return signedInMember()\n        && exists(/databases/$(database)/documents/users/$(request.auth.uid))\n        && managerProfile().get('approved', true) == true;\n    }\n\n    function isAdmin() {\n      return isMember()\n        && managerProfile().role in ['Admin', 'admin'];\n    }\n\n    function isPublisher() {\n      return isMember() && (managerProfile().role in ['Admin', 'admin', 'Coach', 'coach', 'Manager', 'manager', 'Captain', 'captain', 'Socials', 'socials']\n        || managerProfile().get('canEdit', false) == true\n        || managerProfile().get('coachAccess', false) == true\n        || managerProfile().get('managerAccess', false) == true);\n    }\n\n    function canManageGoals() {\n      return isMember()\n        && managerProfile().role in ['Admin', 'admin', 'Coach', 'coach', 'Manager', 'manager'];\n    }\n\n    function canManageNews() {\n      return isMember() && managerProfile().role in ['Admin', 'admin', 'Socials', 'socials'];\n    }\n\n    function isAssignedTo(teamId) {\n      return isMember() && (managerProfile().get('teamId', '') == teamId\n        || teamId in managerProfile().get('teamIds', []));\n    }\n\n    function isTeamCoach(teamId) {\n      return isAssignedTo(teamId) && managerProfile().role in ['Coach', 'coach'];\n    }\n\n    function isAssignedPlayer(teamId) {\n      return isAssignedTo(teamId)\n        && (managerProfile().get('playerId', '') != ''\n          || managerProfile().get('linkedPlayerId', '') != '');\n    }\n\n    function isOwnPlayer(playerId) {\n      return managerProfile().get('playerId', '') == playerId\n        || (managerProfile().get('playerId', '') == ''\n          && managerProfile().get('linkedPlayerId', '') == playerId);\n    }\n\n    function validCoachingNote() {\n      return request.resource.data.keys().hasOnly(['authorId', 'text', 'createdAt'])\n        && request.resource.data.keys().hasAll(['authorId', 'text', 'createdAt'])\n        && request.resource.data.authorId == request.auth.uid\n        && request.resource.data.text is string\n        && request.resource.data.text.size() > 0\n        && request.resource.data.text.size() <= 4000\n        && request.resource.data.createdAt == request.time;\n    }\n\n    match /noctiqManager/main {\n      allow read: if isMember();\n      allow create, delete: if isAdmin();\n      allow update: if isAdmin() || (isMember()\n        && request.resource.data.get('players', []) == resource.data.get('players', [])\n        && (canManageGoals()\n          || request.resource.data.get('managerV8', {}).get('goals', [])\n            == resource.data.get('managerV8', {}).get('goals', [])))\n        || (canManageNews()\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['managerV8', 'updatedAt'])\n          && request.resource.data.get('managerV8', {}).diff(resource.data.get('managerV8', {})).affectedKeys().hasOnly(['news', 'newsInitialized']));\n    }\n\n    match /coachingTeams/{teamId}/notes/{noteId} {\n      allow read: if isAdmin() || isTeamCoach(teamId) || isAssignedPlayer(teamId);\n      allow create: if (isAdmin() || isTeamCoach(teamId)) && validCoachingNote();\n      allow update, delete: if false;\n    }\n\n    match /coachingPlayers/{teamId}/players/{playerId}/notes/{noteId} {\n      allow read: if isAdmin() || isTeamCoach(teamId)\n        || (isAssignedPlayer(teamId) && isOwnPlayer(playerId));\n      allow create: if (isAdmin() || isTeamCoach(teamId)) && validCoachingNote();\n      allow update, delete: if false;\n    }\n\n    match /holofyrnPublic/main {\n      allow read: if request.auth != null;\n      allow create, update: if isPublisher()\n        && request.resource.data.keys().hasOnly(['players', 'results', 'upcomingMatches', 'news', 'competitions', 'staff', 'publishedAt'])\r\n        && request.resource.data.players is list\n        && request.resource.data.results is list\n        && request.resource.data.upcomingMatches is list\n        && request.resource.data.get('news', []) is list\n        && request.resource.data.get('competitions', []) is list\r\n        && request.resource.data.get('staff', []) is list;\n      allow delete: if false;\n    }\n\n    match /users/{userId} {\n      allow read: if isMember();\n      allow create: if isAdmin();\n      allow update: if isAdmin() || (isMember() && request.auth.uid == userId\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n          'name', 'displayName', 'initials', 'discord', 'discordUrl',\n          'instagramUrl', 'xUrl', 'tiktokUrl', 'bio', 'avatarData',\n          'avatarScale', 'avatarX', 'avatarY'\n        ]));\n      allow delete: if false;\n    }\n\n    match /accountDeletionRequests/{userId} {\n      allow read: if isAdmin();\n      allow create, update: if isAdmin()\n        && userId != request.auth.uid\n        && exists(/databases/$(database)/documents/users/$(userId))\n        && request.resource.data.keys().hasOnly(['userId', 'requestedBy', 'status', 'requestedAt'])\n        && request.resource.data.userId == userId\n        && request.resource.data.requestedBy == request.auth.uid\n        && request.resource.data.status == 'pending'\n        && request.resource.data.requestedAt == request.time\n        && getAfter(/databases/$(database)/documents/users/$(userId)).data.approved == false\n        && getAfter(/databases/$(database)/documents/users/$(userId)).data.deletionPending == true;\n      allow delete: if false;\n    }\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-10-16T00:01:48.250511Z","metadata":{"services":["cloud.firestore"]}}
