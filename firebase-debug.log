[debug] [2026-11-15T11:40:39.505Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/noctiq-d1020/rulesets {"name":"projects/noctiq-d1020/rulesets/04b5f090-bf11-4a8e-9699-02ddd664da50","source":{"files":[{"content":"rules_version = '2';\r\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedInMember() {\n      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';\n    }\n\n    function managerProfile() {\n      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;\n    }\n\n    function isMember() {\n      return signedInMember()\n        && exists(/databases/$(database)/documents/users/$(request.auth.uid))\n        && managerProfile().get('approved', true) == true;\n    }\n\n    function isAdmin() {\n      return isMember()\n        && managerProfile().role in ['Admin', 'admin'];\n    }\n\n    function isPublisher() {\n      return isMember()\r\n        && managerProfile().role in ['Admin', 'admin', 'Coach', 'coach', 'Manager', 'manager', 'Captain', 'captain'];\r\n    }\n\r\n    function isManager() {\r\n      return isMember() && managerProfile().role in ['Manager', 'manager'];\r\n    }\r\n\r\n    function isCaptain() {\r\n      return isMember() && managerProfile().role in ['Captain', 'captain'];\r\n    }\r\n\r\n    function isLinkedPlayer() {\r\n      return isMember()\r\n        && (managerProfile().get('playerId', '') != ''\r\n          || managerProfile().get('linkedPlayerId', '') != '');\r\n    }\r\n\r\n    function isCoach() {\r\n      return isMember() && managerProfile().role in ['Coach', 'coach'];\r\n    }\r\n\r\n    function canUpdateManagerData() {\r\n      let changed = request.resource.data.diff(resource.data).affectedKeys();\r\n      let managerV8Changed = request.resource.data.get('managerV8', {}).diff(resource.data.get('managerV8', {})).affectedKeys();\r\n      return changed.hasOnly(['players', 'results', 'availability', 'events', 'managerV8', 'updatedAt'])\r\n        && (!changed.hasAny(['players']) || isManager())\r\n        && (!changed.hasAny(['results']) || isManager())\r\n        && (!changed.hasAny(['availability']) || isCoach() || isCaptain() || isLinkedPlayer())\r\n        && (!changed.hasAny(['managerV8']) ||\r\n          (isManager() && managerV8Changed.hasOnly(['goals', 'matches', 'leagues', 'leagueGames', 'resultFolders'])) ||\r\n          (isCaptain() && managerV8Changed.hasOnly(['matches'])) ||\r\n          (isMember() && managerV8Changed.hasOnly(['notifications'])))\r\n        && (!changed.hasAny(['events']) || isMember());\r\n    }\r\n\n    function canManageNews() {\n      return isAdmin();\r\n    }\n\n    function isAssignedTo(teamId) {\n      return isMember() && (managerProfile().get('teamId', '') == teamId\n        || teamId in managerProfile().get('teamIds', []));\n    }\n\n    function isTeamCoach(teamId) {\n      return isAssignedTo(teamId) && managerProfile().role in ['Coach', 'coach'];\n    }\n\n    function isAssignedPlayer(teamId) {\n      return isAssignedTo(teamId)\n        && (managerProfile().get('playerId', '') != ''\n          || managerProfile().get('linkedPlayerId', '') != '');\n    }\n\n    function isOwnPlayer(playerId) {\n      return managerProfile().get('playerId', '') == playerId\n        || (managerProfile().get('playerId', '') == ''\n          && managerProfile().get('linkedPlayerId', '') == playerId);\n    }\n\n    function validCoachingNote() {\n      return request.resource.data.keys().hasOnly(['authorId', 'text', 'createdAt'])\n        && request.resource.data.keys().hasAll(['authorId', 'text', 'createdAt'])\n        && request.resource.data.authorId == request.auth.uid\n        && request.resource.data.text is string\n        && request.resource.data.text.size() > 0\n        && request.resource.data.text.size() <= 4000\n        && request.resource.data.createdAt == request.time;\n    }\n\n    match /noctiqManager/main {\n      allow read: if isMember();\n      allow create, delete: if isAdmin();\n      allow update: if isAdmin() || canUpdateManagerData()\r\n        || (canManageNews()\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['managerV8', 'updatedAt'])\n          && request.resource.data.get('managerV8', {}).diff(resource.data.get('managerV8', {})).affectedKeys().hasOnly(['news', 'newsInitialized']));\n    }\n\n    match /coachingTeams/{teamId}/notes/{noteId} {\n      allow read: if isAdmin() || isTeamCoach(teamId) || isAssignedPlayer(teamId) || isAssignedTo(teamId);\r\n      allow create: if (isAdmin() || isTeamCoach(teamId)) && validCoachingNote();\n      allow update: if false;\r\n      allow delete: if (isAdmin() || isTeamCoach(teamId)) && resource.data.authorId == request.auth.uid;\r\n    }\n\n    match /coachingPlayers/{teamId}/players/{playerId}/notes/{noteId} {\n      allow read: if isAdmin() || isTeamCoach(teamId)\n        || (isAssignedTo(teamId) && isOwnPlayer(playerId))\r\n        || (isAssignedTo(teamId) && managerProfile().role in ['Manager', 'manager', 'Captain', 'captain']);\r\n      allow create: if (isAdmin() || isTeamCoach(teamId)) && validCoachingNote();\n      allow update: if false;\r\n      allow delete: if (isAdmin() || isTeamCoach(teamId)) && resource.data.authorId == request.auth.uid;\r\n    }\n\n    match /holofyrnPublic/main {\n      allow read: if request.auth != null;\n      allow create, update: if isPublisher()\n        && request.resource.data.keys().hasOnly(['teams', 'players', 'results', 'upcomingMatches', 'news', 'competitions', 'staff', 'publishedAt'])\r\n        && request.resource.data.get('teams', []) is list\r\n        && request.resource.data.players is list\n        && request.resource.data.results is list\n        && request.resource.data.upcomingMatches is list\n        && request.resource.data.get('news', []) is list\n        && request.resource.data.get('competitions', []) is list\r\n        && request.resource.data.get('staff', []) is list;\n      allow delete: if false;\n    }\n\r\n    match /playerPortraits/{playerId} {\r\n      allow read: if request.auth != null;\r\n      allow create, update: if (isAdmin() || isManager())\r\n        && request.resource.data.keys().hasOnly(['dataUrl', 'contentType', 'updatedBy', 'updatedAt'])\r\n        && request.resource.data.keys().hasAll(['dataUrl', 'contentType', 'updatedBy', 'updatedAt'])\r\n        && request.resource.data.dataUrl is string\r\n        && request.resource.data.dataUrl.size() <= 500000\r\n        && request.resource.data.dataUrl.matches('data:image/webp;base64,[A-Za-z0-9+/=]+')\r\n        && request.resource.data.contentType == 'image/webp'\r\n        && request.resource.data.updatedBy == request.auth.uid\r\n        && request.resource.data.updatedAt == request.time;\r\n      allow delete: if isAdmin() || isManager();\r\n    }\r\n\r\n    match /teamArt/{teamId} {\r\n      allow read: if request.auth != null;\r\n      allow create, update: if isAdmin()\r\n        && teamId.matches('[a-z0-9]+(-[a-z0-9]+)*')\r\n        && request.resource.data.keys().hasOnly(['logoDataUrl', 'backgroundDataUrl', 'updatedBy', 'updatedAt'])\r\n        && request.resource.data.keys().hasAny(['logoDataUrl', 'backgroundDataUrl'])\r\n        && request.resource.data.get('logoDataUrl', '') is string\r\n        && request.resource.data.get('logoDataUrl', '').size() <= 450000\r\n        && request.resource.data.get('logoDataUrl', '').matches('(^$|data:image/webp;base64,[A-Za-z0-9+/=]+)')\r\n        && request.resource.data.get('backgroundDataUrl', '') is string\r\n        && request.resource.data.get('backgroundDataUrl', '').size() <= 450000\r\n        && request.resource.data.get('backgroundDataUrl', '').matches('(^$|data:image/webp;base64,[A-Za-z0-9+/=]+)')\r\n        && request.resource.data.updatedBy == request.auth.uid\r\n        && request.resource.data.updatedAt == request.time;\r\n      allow delete: if isAdmin();\r\n    }\r\n\n    match /users/{userId} {\n      allow read: if isMember();\n      allow create: if isAdmin();\n      allow update: if isAdmin() || (isManager() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\r\n          'teamId', 'teamIds', 'playerId', 'linkedPlayerId'\r\n        ])) || (isMember() && request.auth.uid == userId\r\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n          'name', 'displayName', 'initials', 'discord', 'discordUrl',\n          'instagramUrl', 'xUrl', 'tiktokUrl', 'bio', 'avatarData',\n          'avatarScale', 'avatarX', 'avatarY'\n        ]));\n      allow delete: if false;\n    }\n\n    match /accountDeletionRequests/{userId} {\n      allow read: if isAdmin();\n      allow create, update: if isAdmin()\n        && userId != request.auth.uid\n        && exists(/databases/$(database)/documents/users/$(userId))\n        && request.resource.data.keys().hasOnly(['userId', 'requestedBy', 'status', 'requestedAt'])\n        && request.resource.data.userId == userId\n        && request.resource.data.requestedBy == request.auth.uid\n        && request.resource.data.status == 'pending'\n        && request.resource.data.requestedAt == request.time\n        && getAfter(/databases/$(database)/documents/users/$(userId)).data.approved == false\n        && getAfter(/databases/$(database)/documents/users/$(userId)).data.deletionPending == true;\n      allow delete: if false;\n    }\n\r\n    // Isolated Broadcast room documents; no Manager/Main documents are used.\r\n    match /broadcastHubs/{roomId} {\r\n      function isBroadcastEditor() {\r\n        return request.auth != null\r\n          && request.auth.token.firebase.sign_in_provider != 'anonymous'\r\n          && exists(/databases/$(database)/documents/users/$(request.auth.uid))\r\n          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('approved', true) == true\r\n          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Admin', 'admin', 'Coach', 'coach', 'Manager', 'manager', 'Captain', 'captain'];\r\n      }\r\n\r\n      function validLogo(value) {\r\n        return value is string\r\n          && value.size() <= 280000\r\n          && (value.matches('^data:image/webp;base64,[A-Za-z0-9+/=]+$')\r\n            || value.matches('^data:image/svg.*$'));\r\n      }\r\n\r\n      function validBroadcastDocument(data) {\r\n        return data.keys().hasOnly(['ownerUid', 'settings'])\r\n          && data.ownerUid is string\r\n          && (!('settings' in data)\r\n            || (data.settings is map\r\n              && data.settings.keys().hasAll(['homeLogo', 'awayLogo'])\r\n              && validLogo(data.settings.homeLogo)\r\n              && validLogo(data.settings.awayLogo)));\r\n      }\r\n\r\n      allow read: if request.auth != null;\r\n      allow create: if request.auth != null\r\n        && roomId.matches('[A-Za-z0-9_-]{1,100}')\r\n        && request.resource.data.ownerUid == request.auth.uid\r\n        && validBroadcastDocument(request.resource.data);\r\n      allow update: if request.auth != null\r\n        && (resource.data.ownerUid == request.auth.uid || isBroadcastEditor())\r\n        && request.resource.data.ownerUid == resource.data.ownerUid\r\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settings'])\r\n        && validBroadcastDocument(request.resource.data);\r\n      allow delete: if false;\r\n    }\r\n  }\r\n}\r\n","name":"holofyrnmanager/firestore.rules"}]},"createTime":"2026-11-15T11:40:39.288383Z","metadata":{"services":["cloud.firestore"]}}
